# Vercel AI Gateway API key (required for local development; Vercel uses OIDC automatically in production)
AI_GATEWAY_API_KEY=

# Optional: override the default AI Gateway model (default: google/gemini-3.8-flash)
# AI_MODEL=google/gemini-3.8-flash

# Backend .NET API base URL
VITE_API_URL=http://localhost:5000/api/v1
POS_API_URL=http://localhost:5000/api/v1
